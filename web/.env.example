# Variables de la web (interfaz I4 de docs/plan.md). Copiar a .env.local y completar; nunca commitear valores.
# Todas son solo de servidor: ninguna lleva prefijo NEXT_PUBLIC_.

# Secret de la cuenta usdc-distribuidor (G1 la pasa por privado). La usa /api/faucet.
USDC_DISTRIBUTOR_SECRET=

# --- Panel del espacio (/admin) ---
# Contraseña para entrar a /admin.
ADMIN_PASSWORD=
# Firma la cookie de sesión. Mínimo 32 caracteres al azar: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# Secret de la identidad `admin` del contrato (stellar keys secret admin). Firma create_auction al cargar obras.
STELLAR_ADMIN_SECRET=
# Opcionales: wallets que el formulario de carga trae completas. Si falta ESPACIO_WALLET, usa la del admin.
ESPACIO_WALLET=
ARTISTA_WALLET_DEFAULT=

# --- Almacenamiento de obras cargadas, imágenes y contactos ---
# En Vercel: un store de Vercel Blob *privado* conectado al proyecto crea esta variable solo.
# En local, sin esta variable, se guarda todo en web/.data/ (ignorado por git).
BLOB_READ_WRITE_TOKEN=
